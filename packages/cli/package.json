{
  "name": "@glinr/theauth-cli",
  "version": "0.3.3",
  "description": "CLI for theAuth: set up agent identity and MCP OAuth 2.1, run migrations, launch the admin dashboard, codemod from Kavach.",
  "type": "module",
  "bin": {
    "theauth": "./dist/bin.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup && node scripts/prepare-assets.mjs",
    "dev": "tsup --watch",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@glinr/theauth": "workspace:*",
    "@glinr/theauth-hono": "workspace:*",
    "hono": "^4.13.7",
    "@hono/node-server": "^1.19.15"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsup": "^8.4.0",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "theauth",
    "auth",
    "authentication",
    "ai-agents",
    "agent-identity",
    "mcp",
    "model-context-protocol",
    "oauth2",
    "oauth21",
    "cli",
    "setup-wizard",
    "passkeys",
    "typescript",
    "agent",
    "doctor",
    "agent-auth"
  ],
  "author": "TheAuth <support@glinr.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glincker/theauth.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/glincker/theauth/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/glincker/theauth/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
