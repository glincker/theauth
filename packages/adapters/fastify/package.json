{
  "name": "@glinr/theauth-fastify",
  "version": "6.0.0",
  "description": "Fastify adapter for TheAuth - exposes agent auth as HTTP REST endpoints",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "keywords": [
    "theauth",
    "fastify",
    "auth",
    "agent",
    "mcp"
  ],
  "author": "TheAuth <support@glinr.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glincker/theauth.git",
    "directory": "packages/adapters/fastify"
  },
  "peerDependencies": {
    "@glinr/theauth": ">=0.7.1 <3.0.0",
    "fastify": ">=4.0.0",
    "zod": ">=3.0.0"
  },
  "devDependencies": {
    "@glinr/theauth": "workspace:*",
    "@types/node": "^26.6.5",
    "fastify": "^5.12.5",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "zod": "^3.24.0"
  },
  "homepage": "https://docs.theauth.dev/adapters/fastify",
  "bugs": {
    "url": "https://github.com/glincker/theauth/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
