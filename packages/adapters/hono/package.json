{
  "name": "@glinr/theauth-hono",
  "version": "5.0.0",
  "description": "Hono adapter for TheAuth - exposes agent auth as HTTP REST endpoints",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "keywords": [
    "theauth",
    "hono",
    "auth",
    "agent",
    "mcp",
    "agent-auth",
    "cloudflare-workers"
  ],
  "author": "TheAuth <support@glinr.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glincker/theauth.git",
    "directory": "packages/adapters/hono"
  },
  "peerDependencies": {
    "@glinr/theauth": ">=0.6.0 <1.0.0",
    "hono": ">=4.0.0",
    "zod": ">=3.0.0"
  },
  "devDependencies": {
    "@glinr/theauth": "workspace:*",
    "hono": "^4.12.27",
    "tsup": "^8.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "zod": "^3.24.0"
  },
  "homepage": "https://docs.theauth.dev/adapters/hono",
  "bugs": {
    "url": "https://github.com/glincker/theauth/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
