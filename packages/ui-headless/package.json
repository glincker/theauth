{
  "name": "@glinr/theauth-ui-headless",
  "version": "0.2.0",
  "description": "Unstyled, accessible account components for TheAuth: sessions, API and agent tokens, device approval, step-up",
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "license": "MIT",
  "author": "TheAuth <support@glinr.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glincker/theauth.git",
    "directory": "packages/ui-headless"
  },
  "peerDependencies": {
    "@glinr/theauth-client": ">=0.2.0",
    "@glinr/theauth-react": ">=0.6.0",
    "@tanstack/react-query": ">=5.0.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@glinr/theauth-client": "workspace:*",
    "@glinr/theauth-react": "workspace:*",
    "@tanstack/react-query": "^5.0.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.4.0",
    "typescript": "^6.0.3",
    "vitest": "^3.0.0"
  },
  "homepage": "https://docs.theauth.dev/ui-components",
  "bugs": {
    "url": "https://github.com/glincker/theauth/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "theauth",
    "auth",
    "accounts",
    "components",
    "headless",
    "unstyled",
    "react",
    "typescript"
  ],
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    }
  }
}
