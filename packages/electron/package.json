{
  "name": "@glinr/theauth-electron",
  "version": "0.4.0",
  "description": "TheAuth auth client for Electron desktop apps",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "author": "TheAuth <support@glinr.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glincker/theauth.git",
    "directory": "packages/electron"
  },
  "peerDependencies": {
    "electron": ">=28.0.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.0.0",
    "electron": "^41.10.6",
    "react": "^19.0.0",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "homepage": "https://docs.theauth.dev/electron",
  "bugs": {
    "url": "https://github.com/glincker/theauth/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "theauth",
    "auth",
    "electron",
    "desktop",
    "typescript"
  ]
}
