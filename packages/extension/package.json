{
  "name": "@glinr/theauth-extension",
  "version": "0.1.0",
  "description": "OAuth 2.1 authentication for Manifest V3 browser extensions (PKCE, refresh, optional DPoP)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "author": "TheAuth <support@glinr.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glincker/theauth.git",
    "directory": "packages/extension"
  },
  "peerDependencies": {
    "@glinr/theauth-client": ">=0.3.0"
  },
  "peerDependenciesMeta": {
    "@glinr/theauth-client": {
      "optional": true
    }
  },
  "devDependencies": {
    "@glinr/theauth-client": "workspace:*",
    "@types/node": "^26.6.5",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "homepage": "https://docs.theauth.dev/browser-extension",
  "bugs": {
    "url": "https://github.com/glincker/theauth/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "theauth",
    "auth",
    "oauth",
    "pkce",
    "dpop",
    "browser-extension",
    "manifest-v3",
    "typescript"
  ]
}
