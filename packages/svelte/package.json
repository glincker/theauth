{
  "name": "@glinr/theauth-svelte",
  "version": "0.2.0",
  "description": "Svelte stores for TheAuth auth",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "author": "TheAuth <support@glinr.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glincker/theauth.git",
    "directory": "packages/svelte"
  },
  "peerDependencies": {
    "svelte": ">=4.0.0"
  },
  "devDependencies": {
    "svelte": "^5.56.3",
    "tsup": "^8.4.0",
    "typescript": "^6.0.3",
    "vitest": "^3.0.0"
  },
  "homepage": "https://docs.theauth.dev/svelte",
  "bugs": {
    "url": "https://github.com/glincker/theauth/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "theauth",
    "auth",
    "authentication",
    "svelte",
    "stores",
    "typescript"
  ]
}
