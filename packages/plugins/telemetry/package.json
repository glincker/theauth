{
  "name": "@glinr/theauth-plugin-telemetry",
  "version": "4.0.0",
  "description": "OpenTelemetry integration plugin for TheAuth — converts auth events into OTel spans",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "clean": "rm -rf dist .turbo"
  },
  "keywords": [
    "theauth",
    "telemetry",
    "opentelemetry",
    "otel",
    "auth",
    "agent"
  ],
  "author": "TheAuth <support@glinr.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glincker/theauth.git",
    "directory": "packages/plugins/telemetry"
  },
  "peerDependencies": {
    "@glinr/theauth": ">=0.6.0 <1.0.0"
  },
  "devDependencies": {
    "@glinr/theauth": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "better-sqlite3": "^12.9.0",
    "tsup": "^8.4.0",
    "typescript": "^6.0.3",
    "vitest": "^3.0.0"
  },
  "homepage": "https://github.com/glincker/theauth/tree/main/packages/plugins/telemetry#readme",
  "bugs": {
    "url": "https://github.com/glincker/theauth/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "@glinr/theauth": {
      "optional": true
    }
  }
}
