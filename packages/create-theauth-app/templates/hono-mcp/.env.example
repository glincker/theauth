# Long random string used to sign tokens. create-theauth-app already put a
# generated value in .env. To make another: npx @glinr/theauth-cli secret
THEAUTH_SECRET=

# Bearer key for the management API (/api/agents, /api/audit, ...). Without it
# those routes reject every request.
ADMIN_API_KEY=

# Signing secret for MCP JWT access tokens. Must be at least 32 chars.
MCP_SIGNING_SECRET=

# Database URL. SQLite is a file on disk, so data survives restarts.
# SQLite:   ./theauth.db
# Postgres: postgres://user:pass@host:5432/dbname
DATABASE_URL=__DB_URL__

# Base URL the server is reachable at. Appears in .well-known documents and
# access-token claims. Change to your public URL before deploying.
BASE_URL=http://localhost:3001

# Email of the user that owns agents you create from the README smoke test.
OWNER_EMAIL=owner@example.com

# Port to listen on.
PORT=3001
