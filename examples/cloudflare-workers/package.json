{
  "name": "@glinr/theauth-example-cloudflare-workers",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrations:generate": "node scripts/generate-migration.mjs",
    "migrations:apply": "wrangler d1 migrations apply theauth-db --remote",
    "migrations:apply:local": "wrangler d1 migrations apply theauth-db --local",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@glinr/theauth": "workspace:*",
    "@glinr/theauth-hono": "workspace:*",
    "hono": "^4.13.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260418.1",
    "typescript": "^6.0.3",
    "wrangler": "^4.83.0"
  }
}
