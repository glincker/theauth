{
  "name": "@glinr/theauth-root",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.6.5",
  "repository": {
    "type": "git",
    "url": "https://github.com/glincker/theauth.git"
  },
  "homepage": "https://theauth.dev",
  "bugs": "https://github.com/glincker/theauth/issues",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo build --filter='./packages/**'",
    "dev": "turbo dev",
    "clean": "turbo clean && rm -rf node_modules",
    "lint": "biome check .",
    "lint:fix": "biome check . --fix",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "typecheck": "turbo typecheck",
    "test": "node scripts/run-tests.mjs",
    "test:all": "node scripts/run-tests.mjs",
    "test:affected": "node scripts/run-tests.mjs --affected",
    "test:watch": "turbo test:watch",
    "coverage": "turbo coverage",
    "bench": "pnpm --filter @glinr/theauth bench",
    "bench:smoke": "pnpm --filter @glinr/theauth build && node benchmarks/run.mjs --profile smoke --out benchmarks/results/smoke.json && node benchmarks/report.mjs benchmarks/results/smoke.json --out benchmarks/results/smoke.md",
    "bench:ci": "pnpm --filter @glinr/theauth build && node --expose-gc benchmarks/run.mjs --profile full --out benchmarks/results/full.json && node benchmarks/report.mjs benchmarks/results/full.json --out benchmarks/results/full.md",
    "lint:deps": "knip --strict",
    "prepare": "simple-git-hooks",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "turbo build && changeset publish",
    "audit:gate": "node scripts/audit-gate.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.1",
    "@changesets/cli": "^2.30.0",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.9.0",
    "knip": "^5.0.0",
    "simple-git-hooks": "^2.11.0",
    "turbo": "^2.9.14",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint && pnpm --filter @glinr/theauth typecheck",
    "commit-msg": "node scripts/check-commit-title.mjs $1",
    "pre-push": "node scripts/pre-push.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3"
    ],
    "overrides": {
      "proxy-addr@<2.0.8": "^2.0.8",
      "shell-quote@<1.9.0": "^1.9.0",
      "fast-uri@<3.1.6": "^3.1.6",
      "browserslist@<4.28.7": "^4.28.7",
      "picomatch@<2.3.2": "^2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "postcss@<8.5.18": "^8.5.18",
      "ws@>=7.0.0 <7.5.11": "^7.5.11",
      "js-yaml@>=3.0.0 <3.15.2": "^3.15.2",
      "mysql2@<3.22.0": "^3.22.0",
      "brace-expansion@<1.1.20": "^1.1.20"
    }
  }
}
