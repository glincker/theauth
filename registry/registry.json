          "type": "registry:lib",
          "target": "components/theauth/utils.ts"
        },
        {
          "path": "theauth/defaults.tsx",
          "type": "registry:component",
          "target": "components/theauth/defaults.tsx"
        },
        {
          "path": "theauth/auth-card.tsx",
          "type": "registry:component",
          "target": "components/theauth/auth-card.tsx"
        }
      ]
    },
    {
